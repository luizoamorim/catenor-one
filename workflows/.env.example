###############################################################################
### REQUIRED ENVIRONMENT VARIABLES - SENSITIVE INFORMATION                  ###
### Copy this file to `.env` (gitignored) and fill in real values.          ###
### DO NOT UPLOAD OR SHARE `.env` UNDER ANY CIRCUMSTANCES                  ###
###############################################################################
# Ethereum private key for CRE trigger authentication (unfunded, trigger-only). The CLI parses it whenever it is given
# this file, even for private-registry secrets (--secrets-auth browser): replace the placeholder with 64 hex characters,
# e.g. a fresh unfunded key: openssl rand -hex 32.
CRE_ETH_PRIVATE_KEY=YOUR_UNFUNDED_TRIGGER_KEY_HEX
# Default target used when --target is not specified
CRE_TARGET=staging-settings

# Sumsub sandbox credentials (secret values — NEVER commit)
SUMSUB_APP_TOKEN_VAR=
SUMSUB_SECRET_KEY_VAR=

# Catenor internal API token (32 random bytes hex — NEVER commit)
CATENOR_INTERNAL_API_TOKEN_VAR=
