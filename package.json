{
  "name": "catenor-one",
  "private": true,
  "description": "Catenor One — first reference implementation of Catenor Protocol (ETHOnline 2026)",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "pnpm --filter @catenor-one/api db:generate && vitest run --config vitest.integration.config.ts",
    "test:privy-live": "vitest run --config vitest.live.config.ts",
    "boundaries": "depcruise packages test-vectors apps scripts --config .dependency-cruiser.cjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm boundaries && pnpm secret-scan",
    "vectors:s001": "pnpm -r build && node scripts/vectors/generate-s001.mjs",
    "vectors:s001:check": "pnpm vectors:s001 && git diff --exit-code -- test-vectors/s001"
  },
  "devDependencies": {
    "@catenor-one/audit": "workspace:*",
    "@catenor-one/authority": "workspace:*",
    "@catenor-one/credentials": "workspace:*",
    "@catenor-one/identity": "workspace:*",
    "@catenor-one/policy": "workspace:*",
    "@catenor-one/test-vectors": "workspace:*",
    "@eslint/js": "10.0.1",
    "@noble/curves": "2.4.0",
    "@types/node": "24.13.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
