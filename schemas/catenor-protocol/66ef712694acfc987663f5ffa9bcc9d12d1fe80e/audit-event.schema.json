  "title": "Catenor Audit Event \u2014 Draft",
  "type": "object",
  "required": [
    "type",
    "timestamp"
  ],
  "properties": {
    "type": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "credentialId": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "requestId": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
